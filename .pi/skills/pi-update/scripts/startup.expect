#!/usr/bin/env bash

set -euo pipefail

if (( $# > 2 )); then
  printf 'usage: startup.expect [expected-version] [work-dir]\n' >&2
  exit 2
fi

expected_version=${1-}
if [[ -n $expected_version ]]; then
  actual_version=$(mise exec -- pi --version)
  if [[ $actual_version != "$expected_version" ]]; then
    printf 'expected Pi %s, got %s\n' "$expected_version" "$actual_version" >&2
    exit 1
  fi
fi

owns_work_dir=0
if (( $# < 2 )); then
  work_dir=$(mktemp -d /tmp/pi-update-startup.XXXXXX)
  owns_work_dir=1
else
  if [[ ! -d $2 ]]; then
    printf 'work directory does not exist: %s\n' "$2" >&2
    exit 2
  fi
  work_dir=$(cd "$2" && pwd -P)
fi

source_agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
if [[ ! -d $source_agent_dir ]]; then
  printf 'Pi agent directory does not exist: %s\n' "$source_agent_dir" >&2
  exit 2
fi
source_agent_dir=$(cd "$source_agent_dir" && pwd -P)
agent_dir=$(mktemp -d /tmp/pi-update-agent.XXXXXX)
socket="pi-update-startup-$$"
session="pi-update-startup-$$"
log_path="/tmp/pi-update-startup-$$.txt"

cleanup() {
  set +e
  tmux -L "$socket" kill-server >/dev/null 2>&1
  if [[ $agent_dir == /tmp/pi-update-agent.* ]]; then
    rm -rf -- "$agent_dir"
  fi
  if (( owns_work_dir )) && [[ $work_dir == /tmp/pi-update-startup.* ]]; then
    rm -rf -- "$work_dir"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

shopt -s dotglob nullglob
for source in "$source_agent_dir"/*; do
  name=${source##*/}
  case "$name" in
    sessions|tmp|mcp-oauth)
      mkdir -p "$agent_dir/$name"
      ;;
    *.log)
      ;;
    *)
      if [[ -f $source ]]; then
        cp -L -- "$source" "$agent_dir/$name"
      else
        ln -s -- "$source" "$agent_dir/$name"
      fi
      ;;
  esac
done
mkdir -p "$agent_dir/sessions"

probe_path="$agent_dir/pi-update-startup-probe.ts"
cat > "$probe_path" <<'EOF'
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

export default function startupProbe(pi: ExtensionAPI): void {
  pi.on("session_start", (_event, context) => {
    if (context.mode === "tui") {
      context.ui.setWidget("pi-update-startup", ["PI_UPDATE_STARTUP_READY"]);
    }
  });
}
EOF

printf -v pi_command \
  'exec env TERM=xterm-256color COLORTERM=truecolor COLUMNS=90 LINES=32 PI_CODING_AGENT_DIR=%q PI_OFFLINE=1 mise exec -- pi --no-session -e %q' \
  "$agent_dir" "$probe_path"

tmux -L "$socket" -f /dev/null new-session -d -x 90 -y 32 -s "$session" -c "$work_dir" "$pi_command"

trust_answered=0
failure=''
ready=0
for _ in {1..150}; do
  if ! tmux -L "$socket" has-session -t "$session" 2>/dev/null; then
    failure='Pi exited before the editor became ready'
    break
  fi

  pane=$(tmux -L "$socket" capture-pane -p -J -S - -t "$session":0.0 2>/dev/null || true)
  printf '%s\n' "$pane" > "$log_path"

  if grep -Eq 'Failed to load extension|\[Extension errors\]|exiting due to uncaughtException' <<<"$pane"; then
    failure='Pi reported an extension or runtime failure'
    break
  fi

  if (( ! trust_answered )) && grep -Fq 'Trust project folder?' <<<"$pane"; then
    tmux -L "$socket" send-keys -t "$session":0.0 Down Down Enter
    trust_answered=1
  fi

  if grep -Fq 'PI_UPDATE_STARTUP_READY' <<<"$pane" && grep -Eq '^> *$' <<<"$pane"; then
    ready=1
    break
  fi

  sleep 0.1
done

if (( ! ready )); then
  if [[ -z $failure ]]; then
    failure='Pi did not finish loading the custom setup before the deadline'
  fi
  printf 'FAIL: %s\n' "$failure" >&2
  printf 'log: %s\n' "$log_path" >&2
  exit 1
fi

printf 'PASS: Pi started with the full custom setup\n'
printf 'log: %s\n' "$log_path"
