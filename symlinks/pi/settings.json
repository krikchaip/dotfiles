{
  "lastChangelogVersion": "0.85.0",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "treeFilterMode": "no-tools",
  "doubleEscapeAction": "none",
  "steeringMode": "all",
  "followUpMode": "all",
  "autocompleteMaxVisible": 10,
  "outputPad": 1,
  "showHardwareCursor": true,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "theme": "dark-cavern",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "externalEditor": "env NVIM_APPNAME=nvchad nvim",
  "shellPath": "/opt/homebrew/bin/bash",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "enabledModels": [
    "antigravity/gemini-3.8-flash-high",
    "antigravity/claude-opus-4-6-thinking",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "opencode/big-pickle"
  ],
  "compaction": {
    "enabled": true,
    "model": "antigravity/gemini-3.8-flash-high",
    "autoTrigger": {
      "enabled": true,
      "absoluteTokens": "100k",
      "contextWindowFamilies": {
        "200k": "150k",
        "400k": "200k",
        "1m": "250k"
      }
    }
  },
  "branchSummary": {
    "skipPrompt": true,
    "model": "antigravity/gemini-3.8-flash-high",
    "generateLabelModel": "antigravity/gemini-3.8-flash-low"
  },
  "autoRename": {
    "enabled": true,
    "model": "antigravity/gemini-3.8-flash-high"
  },
  "skills": [],
  "extensions": [
    "-extensions/post-compaction-context.ts"
  ],
  "npmCommand": [
    "mise",
    "exec",
    "node@26",
    "--",
    "npm"
  ],
  "packages": [
    "git:github.com/ayghri/i-have-adhd",
    "git:github.com/krikchaip/pi-background-tasks@personal",
    "git:github.com/krikchaip/pi-cc-tools@personal",
    "git:github.com/krikchaip/pi-powerline-footer@personal",
    "git:github.com/krikchaip/pi-token-burden@personal",
    "git:github.com/krikchaip/pi-treex@personal",
    "npm:@gotgenes/pi-permission-system",
    {
      "source": "npm:pi-mcp-adapter@2.27.0",
      "skills": []
    },
    "npm:pi-web-access",
    "packages/image-attachments",
    "packages/oh-my-pi-themes",
    "packages/provider-payload-debug",
    "packages/resume",
    "packages/side-quests"
  ],
  "powerline": {
    "placement": "below",
    "model": {
      "color": "muted",
      "bold": false
    },
    "modelThinking": {
      "wrapper": "none"
    },
    "sessionTitle": {
      "enabled": true,
      "alignment": "right"
    },
    "showLastPrompt": false,
    "layout": {
      "left": [
        "model_thinking",
        "context_pct_plain"
      ],
      "right": [
        "extension_statuses"
      ]
    },
    "customItems": [
      {
        "id": "mcp",
        "excludeFromExtensionStatuses": true
      }
    ]
  },
  "powerlineShortcuts": {
    "copyEditor": "alt+c",
    "cutEditor": "alt+x",
    "editorEnd": "ctrl+shift+e",
    "editorStart": "ctrl+shift+a",
    "queueOpen": null
  }
}
