{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "EDITOR": "env NVIM_APPNAME=nvchad nvim"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "ShareOnboardingGuide",
      "SendFeedback",
      "ReportFindings",
      "EnterPlanMode",
      "ExitPlanMode"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["/tmp"]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "init": "user-invocable-only"
  },
  "disableBundledSkills": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Applications/Claude Code.app/Contents/MacOS/terminal-notifier\" -title \"Claude Code\" -message \"\\\\$(jq -r .message)\" -sound Blow -activate net.kovidgoyal.kitty"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "disableAgentView": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "respondToBashCommands": false,
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 300000,
  "promptSuggestionEnabled": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "remoteControlAtStartup": false,
  "diffTool": "terminal",
  "externalEditorContext": true
}
