# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/master/schema/config.json

gui:
  scrollHeight: 8
  sidePanelWidth: 0.25
  mainPanelSplitMode: vertical
  showListFooter: false
  showFileTree: true
  showRandomTip: true
  showCommandLog: true
  showBottomLine: true
  showPanelJumps: false
  nerdFontsVersion: "3"
  commitHashLength: 8
  showBranchCommitHash: true
  showDivergenceFromBaseBranch: none
  commandLogSize: 4
  splitDiff: auto
  filterMode: fuzzy
  statusPanelView: dashboard
  switchToFilesAfterStashPop: true
  switchToFilesAfterStashApply: false

  # Tokyonight Storm
  # ref: https://github.com/folke/tokyonight.nvim/blob/main/extras/lazygit/tokyonight_storm.yml
  theme:
    activeBorderColor:
      - "#ff9e64"
      - "bold"
    inactiveBorderColor:
      - "#29a4bd"
    searchingActiveBorderColor:
      - "#ff9e64"
      - "bold"
    optionsTextColor:
      - "#7aa2f7"
    selectedLineBgColor:
      - "#2e3c64"
    cherryPickedCommitFgColor:
      - "#7aa2f7"
    cherryPickedCommitBgColor:
      - "#bb9af7"
    markedBaseCommitFgColor:
      - "#7aa2f7"
    markedBaseCommitBgColor:
      - "#e0af68"
    unstagedChangesColor:
      - "#db4b4b"
    defaultFgColor:
      - "#c0caf5"

git:
  diffRenderers:
    # --detect-dark-light=never: delta must not query the terminal for its colors.
    # The reply races lazygit's own tty reader, which delays every diff by ~1s and
    # can leak the reply into lazygit as keystrokes (e.g. ':' opens "Shell command").
    - colorArg: always
      command: >-
        delta --paging=never                \
              --color-only                  \
              --detect-dark-light=never     \
              --hyperlinks                  \
              --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
  commit:
    autoWrapWidth: 80
  parseEmoji: true
  log:
    showGraph: when-maximised
  truncateCopiedCommitHashesTo: 12
  localBranchSortOrder: alphabetical

confirmOnQuit: false

os:
  editPreset: nvim-remote

  # lazygit runs these with $SHELL, which can be nu (Herdr panes) or zsh (Herdr popups).
  # Keep them plain commands, valid in any shell.
  # lazygit-nvim remaps the nvim term close key to '<M-g>' instead of 'q'
  # ref: https://github.com/jesseduffield/lazygit/blob/master/pkg/config/editor_presets.go#L58-L67
  edit: 'lazygit-nvim {{ "{{" }}filename{{ "}}" }}'
  editAtLine: 'lazygit-nvim {{ "{{" }}filename{{ "}}" }} {{ "{{" }}line{{ "}}" }}'
  openDirInEditor: 'lazygit-nvim {{ "{{" }}dir{{ "}}" }}'
  # env runs the external open, not the nu builtin open
  open: 'env open {{ "{{" }}filename{{ "}}" }}'
  openLink: 'env open {{ "{{" }}link{{ "}}" }}'

disableStartupPopups: false
promptToReturnFromSubprocess: false
notARepository: skip

keybinding:
  universal:
    suspendApp: <disabled>
    jumpToBlock:
      - "~"
      - "1"
      - "2"
      - "3"
      - "4"
