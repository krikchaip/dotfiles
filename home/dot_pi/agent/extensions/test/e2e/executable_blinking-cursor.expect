#!/usr/bin/expect -f

set timeout 1
log_user 0
set extension_path "/Users/asol/.pi/agent/extensions/blinking-cursor.ts"
set temp_root "/tmp/blinking-cursor-e2e-[pid]"
set work_dir "$temp_root/work"
set state_dir "$temp_root/state"
set fixture_path "$temp_root/fixture.ts"
set startup_log "$temp_root/startup.ansi"
set reload_log "$temp_root/reload.ansi"
set editor_log "$temp_root/editor.ansi"
set subprocess_log "$temp_root/subprocess.ansi"
set subprocess_idle_log "$temp_root/subprocess-idle.ansi"
set typing_log "$temp_root/typing.ansi"
set blink_log "$temp_root/blink.ansi"
set focus_out_log "$temp_root/focus-out.ansi"
set focus_in_log "$temp_root/focus-in.ansi"
set dialog_log "$temp_root/dialog.ansi"
set dialog_focus_log "$temp_root/dialog-focus.ansi"
set resume_log "$temp_root/resume.ansi"
set scroll_log "$temp_root/scroll.ansi"
set scroll_restore_log "$temp_root/scroll-restore.ansi"
set hotkey_scroll_log "$temp_root/hotkey-scroll.ansi"
set hotkey_scroll_hold_log "$temp_root/hotkey-scroll-hold.ansi"
set hotkey_scroll_restore_log "$temp_root/hotkey-scroll-restore.ansi"
set shutdown_log "$temp_root/shutdown.ansi"
set columns 80
set rows 24
set active_spawn ""
set cadence_durations {}

set begin_sync "\x1b\[?2026h"
set end_sync "\x1b\[?2026l"
set hide_cursor "\x1b\[?25l"
set show_cursor "\x1b\[?25h"
set software_cursor_style "\x1b\[48;2;58;58;74m"

proc cleanup {} {
  global active_spawn temp_root
  if {$active_spawn ne ""} {
    catch {send -i $active_spawn "\003\003"}
    after 150
    catch {close -i $active_spawn}
    catch {wait -i $active_spawn}
    set active_spawn ""
  }
  catch {log_file}
  catch {file delete -force $temp_root}
}

proc readable {text} {
  return [string map [list "\x1b" "<ESC>" "\x07" "<BEL>"] $text]
}

proc failure {message {content ""}} {
  puts stderr "FAIL: $message"
  if {$content ne ""} {
    set start [expr {max(0, [string length $content] - 5000)}]
    puts stderr [readable [string range $content $start end]]
  }
  cleanup
  exit 1
}

proc read_binary {path} {
  set channel [open $path r]
  fconfigure $channel -translation binary -encoding binary
  set content [read $channel]
  close $channel
  return $content
}

proc require_bytes {content needle label} {
  if {[string first $needle $content] < 0} {
    failure "missing $label" $content
  }
}

proc forbid_bytes {content needle label} {
  if {[string first $needle $content] >= 0} {
    failure "unexpected $label" $content
  }
}

proc drain_until {seconds pattern} {
  global active_spawn
  set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
  while {[clock milliseconds] < $deadline} {
    expect -i $active_spawn \
      "\033\[c" { send -i $active_spawn -- "\033\[?1;2c"; exp_continue -continue_timer } \
      "\033\[?u" { send -i $active_spawn -- "\033\[?0u"; exp_continue -continue_timer } \
      "Trust project folder?" { failure "unexpected project trust prompt" } \
      -re $pattern { return 1 } \
      timeout {} \
      eof { return 0 }
  }
  return 0
}

proc drain_for {seconds pattern} {
  global active_spawn
  set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
  while {[clock milliseconds] < $deadline} {
    expect -i $active_spawn \
      "\033\[c" { send -i $active_spawn -- "\033\[?1;2c"; exp_continue -continue_timer } \
      "\033\[?u" { send -i $active_spawn -- "\033\[?0u"; exp_continue -continue_timer } \
      -re $pattern { exp_continue -continue_timer } \
      timeout {} \
      eof { return }
  }
}

proc drain_ready {} {
  global active_spawn
  while {1} {
    expect -i $active_spawn -timeout 0 \
      "\033\[c" { send -i $active_spawn -- "\033\[?1;2c" } \
      "\033\[?u" { send -i $active_spawn -- "\033\[?0u" } \
      -re {(.|\n)+} {} \
      timeout { return } \
      eof { return }
  }
}

proc rotate_log {path} {
  catch {log_file}
  log_file -a -noappend $path
}

proc require_cursor_phase_duration {started_at pattern label log_path} {
  global cadence_durations
  if {![drain_until 2 $pattern]} {
    failure "$label did not end" [read_binary $log_path]
  }
  set ended_at [clock milliseconds]
  set duration_ms [expr {$ended_at - $started_at}]
  if {$duration_ms < 450 || $duration_ms > 650} {
    failure "$label lasted ${duration_ms} ms, expected 450-650 ms" \
      [read_binary $log_path]
  }
  lappend cadence_durations $duration_ms
  return $ended_at
}

proc assert_no_visible_cursor_movement {content label {minimum_movements 20}} {
  set cursor_visible 1
  set movement_count 0
  set tokens [regexp -all -inline {\x1b\[\?25[hl]|\x1b\[[0-9]+;[0-9]+H} $content]

  foreach token $tokens {
    if {$token eq "\x1b\[?25l"} {
      set cursor_visible 0
    } elseif {$token eq "\x1b\[?25h"} {
      set cursor_visible 1
    } else {
      incr movement_count
      if {$cursor_visible} {
        failure "$label moved the visible hardware cursor during repaint" $content
      }
    }
  }

  if {$movement_count < $minimum_movements} {
    failure "$label produced $movement_count cursor movements, expected at least $minimum_movements" \
      $content
  }
}

proc assert_scroll_frames_use_software_cursor {content} {
  global begin_sync end_sync hide_cursor show_cursor software_cursor_style
  set checked 0
  set software_cursor_frames 0
  set search_from 0

  while {1} {
    set begin_at [string first $begin_sync $content $search_from]
    if {$begin_at < 0} break
    set frame_start [expr {$begin_at + [string length $begin_sync]}]
    set end_at [string first $end_sync $content $frame_start]
    if {$end_at < 0} { set end_at [string length $content] }
    set frame [string range $content $frame_start [expr {$end_at - 1}]]
    set search_from [expr {$end_at + [string length $end_sync]}]

    set moves [regexp -all -inline -indices {\x1b\[[0-9]+;[0-9]+H} $frame]
    if {[llength $moves] < 2} continue

    incr checked
    set first_move_at [lindex [lindex $moves 0] 0]
    set hide_at [string first $hide_cursor $frame]
    if {$hide_at < 0 || $hide_at > $first_move_at} {
      failure "hardware cursor was not hidden before scroll-frame movement" $frame
    }
    if {[string first $show_cursor $frame] >= 0} {
      failure "rapid scrolling restored the hardware cursor during software-cursor mode" $frame
    }
    if {[string first $software_cursor_style $frame] >= 0} {
      incr software_cursor_frames
    }
  }

  if {$checked < 5} {
    failure "rapid scrolling produced fewer than five cursor-bearing repaint frames" $content
  }
  if {$software_cursor_frames < 5} {
    failure "rapid scrolling did not render a stable software cursor" $content
  }
}

proc assert_shutdown_final_state {content} {
  global hide_cursor show_cursor
  set focus_disabled [string last "\x1b\[?1004l" $content]
  set default_cursor [string last "\x1b\[0 q" $content]
  set cursor_shown [string last $show_cursor $content]
  set cursor_hidden [string last $hide_cursor $content]

  if {$focus_disabled < 0 || $default_cursor < 0 || $cursor_shown < 0} {
    failure "shutdown omitted terminal cursor restoration" $content
  }
  if {$cursor_shown < $default_cursor || $cursor_shown < $cursor_hidden} {
    failure "shutdown did not leave the hardware cursor visible" $content
  }
}

file mkdir $work_dir
file mkdir $state_dir
set nvim_path [auto_execok nvim]
if {$nvim_path eq ""} {
  failure "nvim is required for the external-editor cursor test"
}
set settings [open "$state_dir/settings.json" w]
puts $settings " {\"showHardwareCursor\":true,\"tuiMode\":\"fullscreen\",\"externalEditor\":\"$nvim_path --clean -n\"} "
close $settings
set keybindings [open "$state_dir/keybindings.json" w]
puts $keybindings { {"app.editor.external":["alt+e"],"tui.altScreen.halfPageUp":["ctrl+up"],"tui.altScreen.halfPageDown":["ctrl+down"]} }
close $keybindings

set fixture [open $fixture_path w]
puts $fixture {
export default function (pi: any): void {
  pi.on("session_start", (_event: unknown, ctx: any) => {
    if (ctx.mode === "tui") ctx.ui.setStatus("cursor-e2e", "CURSOR_E2E_READY");
  });

  pi.registerCommand("cursor-dialog", {
    description: "Open a cursorless dialog for focus testing",
    handler: async (_args: string, ctx: any) => {
      await ctx.ui.select("CURSOR_DIALOG_OPEN", ["Keep dialog open"]);
    },
  });

  pi.registerCommand("seed-scroll", {
    description: "Seed a long transcript for cursor scroll testing",
    handler: () => {
      for (let index = 1; index <= 80; index += 1) {
        pi.sendMessage({
          customType: "cursor-scroll-fixture",
          content: `CURSOR_SCROLL_FIXTURE_${String(index).padStart(3, "0")} ${"transcript ".repeat(8)}`,
          display: true,
        });
      }
    },
  });
}
}
close $fixture

if {![file exists $extension_path]} {
  failure "runtime extension not found: $extension_path"
}

cd $work_dir
log_file -a -noappend $startup_log
spawn env TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows \
  PI_OFFLINE=1 PI_CODING_AGENT_DIR=$state_dir \
  pi --tui-mode fullscreen --no-session --no-context-files --no-prompt-templates \
  --no-themes --no-extensions --no-skills --no-tools \
  -e $extension_path -e $fixture_path
set active_spawn $spawn_id
stty columns $columns rows $rows

if {![drain_until 10 {CURSOR_E2E_READY}]} {
  failure "Pi fullscreen TUI did not become ready" [read_binary $startup_log]
}
drain_for 1 {CURSOR_E2E_READY}
set startup [read_binary $startup_log]
require_bytes $startup "\x1b\[?1004h" "focus reporting enable"
require_bytes $startup "\x1b\[2 q" "steady block cursor mode"
forbid_bytes $startup "\x1b\[1 q" "terminal-managed blinking cursor mode"
require_bytes $startup $show_cursor "hardware cursor show"

rotate_log $reload_log
send -i $active_spawn -- "/reload\r"
if {![drain_until 15 {Reloaded keybindings, extensions}]} {
  failure "Pi did not complete /reload" [read_binary $reload_log]
}
drain_for 1 {Reloaded keybindings, extensions}

rotate_log $editor_log
send -i $active_spawn -- "X"
if {![drain_until 5 {X}]} {
  failure "editor input did not render" [read_binary $editor_log]
}
drain_for 0.25 {X}
set editor [read_binary $editor_log]
forbid_bytes $editor "\x1b\[7m" "inverse-video software cursor"

rotate_log $subprocess_log
send -i $active_spawn -- "\033e"
if {![drain_until 5 {prompt\.md}]} {
  failure "Alt+E did not open the external Neovim editor" \
    [read_binary $subprocess_log]
}
drain_for 0.5 {prompt\.md}
set subprocess_launch [read_binary $subprocess_log]
forbid_bytes $subprocess_launch "\x1b\[0 q" \
  "default blinking cursor mode before Neovim owns the terminal"
rotate_log $subprocess_idle_log
drain_for 1.2 {.}
set subprocess_idle [read_binary $subprocess_idle_log]
forbid_bytes $subprocess_idle $hide_cursor \
  "Pi cursor blink hide while Neovim owns the terminal"
forbid_bytes $subprocess_idle $show_cursor \
  "Pi cursor blink show while Neovim owns the terminal"
send -i $active_spawn -- "\033:q!\r"
if {![drain_until 5 {CURSOR_E2E_READY}]} {
  failure "Pi did not resume after Neovim exited" [read_binary $subprocess_log]
}
drain_for 0.25 {CURSOR_E2E_READY}

rotate_log $typing_log
for {set key 0} {$key < 14} {incr key} {
  send -i $active_spawn -- "z"
  after 100
}
drain_for 0.5 {z}
assert_no_visible_cursor_movement [read_binary $typing_log] \
  "continuous typing stress" 5

send -i $active_spawn -- "Q"
if {![drain_until 3 {Q}]} {
  failure "cadence trigger input did not render" [read_binary $typing_log]
}
drain_ready
rotate_log $blink_log
set phase_started_at [clock milliseconds]
set phase_started_at [require_cursor_phase_duration $phase_started_at \
  {\x1b\[\?25l} "first visible blink phase" $blink_log]
set phase_started_at [require_cursor_phase_duration $phase_started_at \
  {\x1b\[\?25h} "first hidden blink phase" $blink_log]
set phase_started_at [require_cursor_phase_duration $phase_started_at \
  {\x1b\[\?25l} "second visible blink phase" $blink_log]
require_cursor_phase_duration $phase_started_at \
  {\x1b\[\?25h} "second hidden blink phase" $blink_log
set blink [read_binary $blink_log]
forbid_bytes $blink $begin_sync "repaint-driven blink timing"

if {![drain_until 2 {\x1b\[\?25l}]} {
  failure "could not align focus-out with a hidden blink phase" [read_binary $blink_log]
}
rotate_log $focus_out_log
send -i $active_spawn -- "\033\[O"
if {![drain_until 3 {\x1b\[\?25l}]} {
  failure "focus-out did not hide cursor" [read_binary $focus_out_log]
}
require_bytes [read_binary $focus_out_log] $hide_cursor "focus-out cursor hide"

rotate_log $focus_in_log
send -i $active_spawn -- "\033\[I"
after 400
drain_ready
set solid_focus_in [read_binary $focus_in_log]
require_bytes $solid_focus_in $show_cursor "immediate focus-in cursor show"
forbid_bytes $solid_focus_in $hide_cursor "focus-in blink before idle delay"
forbid_bytes $solid_focus_in "\x1b\[2 q" "focus-in cursor-mode reset"
after 200
drain_ready
require_bytes [read_binary $focus_in_log] $hide_cursor \
  "focus-in blink after idle delay"

rotate_log $dialog_log
send -i $active_spawn -- "\025/cursor-dialog\r"
if {![drain_until 5 {CURSOR_DIALOG_OPEN}]} {
  failure "cursorless dialog did not open" [read_binary $dialog_log]
}
drain_for 0.25 {CURSOR_DIALOG_OPEN}
require_bytes [read_binary $dialog_log] $hide_cursor "dialog cursor hide"

rotate_log $dialog_focus_log
send -i $active_spawn -- "\033\[O"
if {![drain_until 3 {\x1b\[\?25l}]} {
  failure "dialog focus-out did not hide cursor" [read_binary $dialog_focus_log]
}
rotate_log $dialog_focus_log
send -i $active_spawn -- "\033\[I"
drain_for 0.4 {CURSOR_DIALOG_OPEN}
forbid_bytes [read_binary $dialog_focus_log] $show_cursor \
  "stale hardware cursor show while dialog owns focus"
send -i $active_spawn -- "\033"
drain_for 0.5 {CURSOR_E2E_READY|X}

rotate_log $startup_log
send -i $active_spawn -- "\025/seed-scroll\r"
if {![drain_until 8 {CURSOR_SCROLL_FIXTURE_080}]} {
  failure "transcript fixture did not render" [read_binary $startup_log]
}
drain_for 0.5 {CURSOR_SCROLL_FIXTURE}

rotate_log $resume_log
for {set cycle 0} {$cycle < 20} {incr cycle} {
  send -i $active_spawn -- "\025/resume\r"
  if {![drain_until 3 {Resume Session}]} {
    failure "resume selector did not open in stress cycle $cycle" [read_binary $resume_log]
  }
  after 25
  drain_ready
  send -i $active_spawn -- "\033"
  if {![drain_until 3 {\x1b\[\?25h}]} {
    failure "resume selector did not restore the editor cursor in stress cycle $cycle" \
      [read_binary $resume_log]
  }
  after 25
  drain_ready
}
assert_no_visible_cursor_movement [read_binary $resume_log] \
  "rapid resume selector stress"

rotate_log $scroll_log
for {set wheel 0} {$wheel < 26} {incr wheel} {
  set button [expr {$wheel % 2 == 0 ? 64 : 65}]
  send -i $active_spawn -- "\033\[<$button;40;10M"
  after 50
  drain_ready
}
set scroll [read_binary $scroll_log]
assert_scroll_frames_use_software_cursor $scroll

# Wait past the 500 ms deadline, then discard wheel output that was buffered
# by the PTY before testing the restored hardware-cursor mode.
after 700
drain_ready
rotate_log $scroll_restore_log
send -i $active_spawn -- "Y"
if {![drain_until 3 {Y}]} {
  failure "editor did not repaint after scroll idle" [read_binary $scroll_restore_log]
}
drain_for 0.25 {Y}
set scroll_restore [read_binary $scroll_restore_log]
set restored_editor_at [string last "Y" $scroll_restore]
if {$restored_editor_at < 0} {
  failure "restored editor marker missing after scroll idle" $scroll_restore
}
set restored_editor [string range $scroll_restore $restored_editor_at end]
require_bytes $restored_editor $show_cursor \
  "hardware cursor restore after scroll idle"
forbid_bytes $restored_editor "\x1b\[7m" \
  "software cursor after scroll idle"

rotate_log $hotkey_scroll_log
set hotkey_sequences [list "\033\[5~" "\033\[6~" "\033\[1;5A" "\033\[1;5B"]
for {set key 0} {$key < 28} {incr key} {
  send -i $active_spawn -- [lindex $hotkey_sequences [expr {$key % 4}]]
  after 50
  drain_ready
}
set hotkey_scroll [read_binary $hotkey_scroll_log]
assert_scroll_frames_use_software_cursor $hotkey_scroll

# Verify that the final configured hotkey keeps software-cursor mode active
# before the 500 ms deadline and restores hardware mode after the deadline.
rotate_log $hotkey_scroll_hold_log
after 250
drain_ready
forbid_bytes [read_binary $hotkey_scroll_hold_log] $show_cursor \
  "hardware cursor restore before hotkey scroll idle"
after 300
drain_ready
rotate_log $hotkey_scroll_restore_log
send -i $active_spawn -- "Z"
if {![drain_until 3 {Z}]} {
  failure "editor did not repaint after hotkey scroll idle" \
    [read_binary $hotkey_scroll_restore_log]
}
drain_for 0.25 {Z}
set hotkey_scroll_restore [read_binary $hotkey_scroll_restore_log]
set hotkey_restored_editor_at [string last "Z" $hotkey_scroll_restore]
if {$hotkey_restored_editor_at < 0} {
  failure "restored editor marker missing after hotkey scroll idle" \
    $hotkey_scroll_restore
}
set hotkey_restored_editor \
  [string range $hotkey_scroll_restore $hotkey_restored_editor_at end]
require_bytes $hotkey_restored_editor $show_cursor \
  "hardware cursor restore after hotkey scroll idle"
forbid_bytes $hotkey_restored_editor "\x1b\[7m" \
  "software cursor after hotkey scroll idle"

rotate_log $shutdown_log
send -i $active_spawn -- "\025/quit\r"
if {![drain_until 8 {\x1b\[0 q\x1b\[\?25h}]} {
  failure "Pi did not restore the terminal cursor during shutdown" [read_binary $shutdown_log]
}
catch {close -i $active_spawn}
catch {wait -i $active_spawn}
set active_spawn ""
set shutdown [read_binary $shutdown_log]
assert_shutdown_final_state $shutdown

puts "PASS blinking-cursor real-PTY E2E: cadence [join $cadence_durations /] ms; fixed-clock hardware blink, software-cursor removal, editor and dialog focus transitions, solid software cursor during wheel and configured-hotkey scrolling, and shutdown restore"
cleanup
exit 0
