#!/usr/bin/expect -f

set timeout 1
log_user 0
set extension_path [file normalize [file join [file dirname [info script]] ../.. color-highlight.ts]]
set expected_version "0.84.4"
if {[info exists env(PI_E2E_EXPECT_VERSION)]} {
  set expected_version $env(PI_E2E_EXPECT_VERSION)
}
set temp_root "/tmp/color-highlight-e2e-[pid]"
set work_dir "$temp_root/work"
set state_dir "$temp_root/state"
set fixture_path "$temp_root/fixture.ts"
set startup_log "$temp_root/startup.ansi"
set editor_log "$temp_root/editor.ansi"
set cursor_log "$temp_root/cursor.ansi"
set reload_log "$temp_root/reload.ansi"
set color256_log "$temp_root/256color.ansi"
set fullscreen_log "$temp_root/fullscreen.ansi"
set columns 100
set rows 34
set active_spawn ""

proc cleanup {} {
  global active_spawn temp_root
  if {$active_spawn ne ""} {
    catch {send -i $active_spawn "\003\003"}
    after 150
    catch {close -i $active_spawn}
    catch {wait -i $active_spawn}
    set active_spawn ""
  }
  catch {log_file}
  catch {file delete -force $temp_root}
}

proc readable {text} {
  return [string map [list "\x1b" "<ESC>" "\x07" "<BEL>"] $text]
}

proc failure {message {content ""}} {
  puts stderr "FAIL: $message"
  if {$content ne ""} {
    set start [expr {max(0, [string length $content] - 5000)}]
    puts stderr [readable [string range $content $start end]]
  }
  cleanup
  exit 1
}

proc read_binary {path} {
  set channel [open $path r]
  fconfigure $channel -translation binary -encoding binary
  set content [read $channel]
  close $channel
  return $content
}

proc require_bytes {content needle label} {
  if {[string first $needle $content] < 0} {
    failure "missing $label" $content
  }
}

proc forbid_bytes {content needle label} {
  if {[string first $needle $content] >= 0} {
    failure "unexpected $label" $content
  }
}

proc drain_until {seconds pattern} {
  global active_spawn
  set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
  while {[clock milliseconds] < $deadline} {
    expect -i $active_spawn \
      "\033\[c" { send -i $active_spawn -- "\033\[?1;2c"; exp_continue -continue_timer } \
      "\033\[?u" { send -i $active_spawn -- "\033\[?0u"; exp_continue -continue_timer } \
      "Trust project folder?" { failure "unexpected project trust prompt" } \
      -re $pattern { return 1 } \
      timeout {} \
      eof { return 0 }
  }
  return 0
}

proc drain_for {seconds pattern} {
  global active_spawn
  set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
  while {[clock milliseconds] < $deadline} {
    expect -i $active_spawn \
      "\033\[c" { send -i $active_spawn -- "\033\[?1;2c"; exp_continue -continue_timer } \
      "\033\[?u" { send -i $active_spawn -- "\033\[?0u"; exp_continue -continue_timer } \
      -re $pattern { exp_continue -continue_timer } \
      timeout {} \
      eof { return }
  }
}

proc stop_pi {} {
  global active_spawn
  if {$active_spawn eq ""} return
  send -i $active_spawn "\003\003"
  expect -i $active_spawn {
    eof {}
    timeout {}
  }
  catch {close -i $active_spawn}
  catch {wait -i $active_spawn}
  set active_spawn ""
}

proc spawn_pi {log_path color_mode tui_mode} {
  global active_spawn columns extension_path fixture_path rows state_dir work_dir

  file mkdir $work_dir
  file mkdir $state_dir
  set settings [open "$state_dir/settings.json" w]
  puts $settings "{\"tuiMode\":\"$tui_mode\"}"
  close $settings

  log_file -a -noappend $log_path
  if {$color_mode eq "truecolor"} {
    spawn env TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows \
      PI_OFFLINE=1 PI_CODING_AGENT_DIR=$state_dir \
      pi --no-session --no-context-files --no-prompt-templates --no-themes \
      --no-extensions --no-skills --no-tools \
      -e $extension_path -e $fixture_path
  } else {
    spawn env TERM=xterm-256color COLORTERM= COLUMNS=$columns LINES=$rows \
      PI_OFFLINE=1 PI_CODING_AGENT_DIR=$state_dir \
      pi --no-session --no-context-files --no-prompt-templates --no-themes \
      --no-extensions --no-skills --no-tools \
      -e $extension_path -e $fixture_path
  }
  set active_spawn $spawn_id
  stty columns $columns rows $rows

  if {![drain_until 10 {COLOR_E2E_READY}]} {
    set content ""
    if {[file exists $log_path]} { set content [read_binary $log_path] }
    failure "Pi TUI did not become ready" $content
  }
  drain_for 1 {COLOR_E2E_READY|TRANSCRIPT|WIDGET|INCOMPLETE|SEVEN|EIGHT}
}

file mkdir $temp_root
file mkdir $work_dir
set fixture [open $fixture_path w]
puts $fixture {
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

export default function (pi: ExtensionAPI) {
  pi.on("session_start", (_event, ctx) => {
    ctx.ui.setWidget("color-e2e", [
      "COLOR_E2E_READY",
      "WIDGET #00FF00",
      "DARK #000000",
      "INCOMPLETE #12345",
      "SEVEN #1234567",
      "EIGHT #12345678",
      "KITTY \x1b_Ga=T,f=100,t=d,s=1,v=1;AAAA\x1b\\ #A1B2C3",
      "TMUX \x1bPtmux;\x1b\x1b_Ga=T,f=100,t=d,s=1,v=1;AAAA\x1b\x1b\\\x1b\\ #B2C3D4",
      "ITERM \x1b]1337;File=name=#C3D4E5;width=1px;height=1px:AAAA\x07",
    ]);
    pi.sendMessage({
      customType: "color-e2e-transcript",
      content: "TRANSCRIPT #336699",
      display: true,
    });
  });
}
}
close $fixture

if {![file exists $extension_path]} {
  failure "runtime extension not found: $extension_path"
}

# Truecolor startup: transcript, widget, dark contrast, and invalid lengths.
cd $work_dir
spawn_pi $startup_log truecolor regular
set startup [read_binary $startup_log]
require_bytes $startup "v$expected_version" "exact Pi version"
require_bytes $startup "TRANSCRIPT" "transcript marker"
require_bytes $startup "WIDGET" "widget marker"
require_bytes $startup "\x1b\[38;2;255;255;255m\x1b\[48;2;51;102;153m#" \
  "white-on-#336699 transcript highlight"
require_bytes $startup "\x1b\[38;2;0;0;0m\x1b\[48;2;0;255;0m#" \
  "black-on-#00FF00 widget highlight"
require_bytes $startup "\x1b\[38;2;255;255;255m\x1b\[48;2;0;0;0m#" \
  "white-on-#000000 widget highlight"
require_bytes $startup "INCOMPLETE #12345" "plain incomplete token"
require_bytes $startup "SEVEN #1234567" "plain seven-digit token"
require_bytes $startup "EIGHT #12345678" "plain eight-digit token"
forbid_bytes $startup "\x1b\[48;2;18;52;86m" "partial #123456 highlight"

# Image-wire safety: real Kitty, tmux-wrapped Kitty, and iTerm2 payload lines
# must pass through as one exact byte sequence. No SGR bytes may enter them.
require_bytes $startup "KITTY \x1b_Ga=T,f=100,t=d,s=1,v=1;AAAA\x1b\\ #A1B2C3" \
  "unmodified Kitty graphics payload"
require_bytes $startup "TMUX \x1bPtmux;\x1b\x1b_Ga=T,f=100,t=d,s=1,v=1;AAAA\x1b\x1b\\\x1b\\ #B2C3D4" \
  "unmodified tmux-wrapped Kitty graphics payload"
require_bytes $startup "ITERM \x1b]1337;File=name=#C3D4E5;width=1px;height=1px:AAAA\x07" \
  "unmodified iTerm2 inline-image payload"
forbid_bytes $startup "\x1b\[48;2;161;178;195m" "SGR inserted into Kitty image line"
forbid_bytes $startup "\x1b\[48;2;178;195;212m" "SGR inserted into tmux Kitty image line"
forbid_bytes $startup "\x1b\[48;2;195;212;229m" "SGR inserted into iTerm2 image line"

# Live editor: exact token highlights, invalid lengths stay plain.
log_file
log_file -a -noappend $editor_log
send -i $active_spawn -- "EDITOR #FF0000 INCOMPLETE #12345 SEVEN #1234567"
if {![drain_until 5 {EDITOR}]} {
  failure "editor text did not render" [read_binary $editor_log]
}
drain_for 1 {EDITOR|INCOMPLETE|SEVEN}
set editor [read_binary $editor_log]
require_bytes $editor "\x1b\[38;2;0;0;0m\x1b\[48;2;255;0;0m#" \
  "black-on-#FF0000 editor highlight"
require_bytes $editor "#12345" "plain incomplete editor token"
require_bytes $editor "#1234567" "plain seven-digit editor token"
forbid_bytes $editor "\x1b\[48;2;18;52;86m" "partial editor highlight"

# Cursor priority: move from end to the final character of the seven-digit value.
# That token is intentionally plain, so replace the editor with one exact token first.
send -i $active_spawn -- "\025"
after 250
send -i $active_spawn -- "CURSOR #FF0000"
drain_for 1 {CURSOR}
log_file
log_file -a -noappend $cursor_log
send -i $active_spawn -- "\033\[D"
if {![drain_until 5 {CURSOR}]} {
  failure "cursor movement did not repaint editor" [read_binary $cursor_log]
}
drain_for 1 {CURSOR}
set cursor [read_binary $cursor_log]
require_bytes $cursor "\x1b\[7m0\x1b\[0m" "inverse-video cursor cell"
forbid_bytes $cursor "\x1b\[7m\x1b\[38;2;" "hex foreground inside cursor cell"

# ANSI adds no visible source characters: remove terminal controls and verify literals.
set python_check {
import re, sys
s = open(sys.argv[1], "rb").read().decode("utf-8", "replace")
s = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", s)
s = re.sub(r"\x1b\][^\x07]*(?:\x07|\x1b\\)", "", s)
s = re.sub(r"\x1b_[^\x07]*(?:\x07|\x1b\\)", "", s)
for token in ("#FF0000", "#12345", "#1234567"):
    if token not in s:
        raise SystemExit(f"visible token changed or missing: {token}")
}
if {[catch {exec python3 -c $python_check $editor_log} python_error]} {
  failure "visible editor source changed: $python_error" $editor
}

# Reload must restore the original renderer once, then install one fresh patch.
send -i $active_spawn -- "\003"
after 250
send -i $active_spawn -- "/reload\r"
if {![drain_until 15 {Reloaded}]} {
  failure "Pi did not complete color-highlight reload" [read_binary $cursor_log]
}
log_file
log_file -a -noappend $reload_log
send -i $active_spawn -- "RELOADED #112233"
if {![drain_until 5 {RELOADED}]} {
  failure "editor did not render after reload" [read_binary $reload_log]
}
drain_for 1 {RELOADED}
set reloaded [read_binary $reload_log]
require_bytes $reloaded "\x1b\[38;2;255;255;255m\x1b\[48;2;17;34;51m#" \
  "single color highlight after reload"
stop_pi
log_file

# Fullscreen mode uses the alternate-screen renderer.
file delete -force $state_dir
spawn_pi $fullscreen_log truecolor fullscreen
log_file
log_file -a -noappend $fullscreen_log
send -i $active_spawn -- "FULLSCREEN #FF5733"
if {![drain_until 5 {FULLSCREEN}]} {
  failure "fullscreen editor text did not render" [read_binary $fullscreen_log]
}
drain_for 1 {FULLSCREEN}
set fullscreen [read_binary $fullscreen_log]
require_bytes $fullscreen "\x1b\[38;2;0;0;0m\x1b\[48;2;255;87;51m#" \
  "black-on-#FF5733 fullscreen editor highlight"
stop_pi
log_file

# 256-color fallback: #0000FF maps to xterm index 21 with white foreground.
file delete -force $state_dir
spawn_pi $color256_log 256color regular
log_file
log_file -a -noappend $color256_log
send -i $active_spawn -- "FALLBACK #0000FF"
if {![drain_until 5 {FALLBACK}]} {
  failure "256-color editor text did not render" [read_binary $color256_log]
}
drain_for 1 {FALLBACK}
set color256 [read_binary $color256_log]
require_bytes $color256 "\x1b\[38;5;231m\x1b\[48;5;21m#" \
  "nearest 256-color #0000FF highlight"
stop_pi

puts "PASS color-highlight real-PTY E2E: transcript, widget, editor, image-wire safety, reload, fullscreen, cursor priority, boundaries, width/source preservation, truecolor, and 256-color fallback"
cleanup
exit 0
