{
  "name": "side-quests",
  "private": true,
  "version": "0.0.0",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "test:e2e": "bun test/e2e/run.ts",
    "test:e2e:version": "bun test/e2e/version-contract.ts",
    "test:prompt": "bun test/e2e/model-behavior.ts",
    "test": "bun run check && bun run typecheck && bun run test:unit && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/bun": "^1.3.14",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
