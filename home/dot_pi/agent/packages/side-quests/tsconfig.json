{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["bun"]
  },
  "include": [
    "*.ts",
    "parent/**/*.ts",
    "child/**/*.ts",
    "test/unit/**/*.ts",
    "test/e2e/**/*.ts"
  ]
}
