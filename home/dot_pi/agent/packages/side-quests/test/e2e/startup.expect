#!/usr/bin/expect -f

set timeout 1
set mode [lindex $argv 0]
set extension [lindex $argv 1]
set work_dir [lindex $argv 2]
set state_dir [lindex $argv 3]
set log_path [lindex $argv 4]

file mkdir $work_dir
cd $work_dir
log_file -noappend $log_path

set command [list env]
if {$mode eq "outside"} {
  lappend command -u TMUX -u TMUX_PANE
}
lappend command TERM=xterm-256color COLORTERM=truecolor COLUMNS=80 LINES=30 PI_OFFLINE=1 PI_CODING_AGENT_DIR=$state_dir
if {$mode eq "child"} {
  lappend command PI_SIDE_QUESTS_CHILD_ID=e2e-child
}
lappend command pi --no-session --no-context-files --no-prompt-templates --no-themes --no-extensions --no-skills -e $extension
if {$mode eq "child"} {
  lappend command -e [file join [file dirname $extension] child index.ts]
}
spawn {*}$command
stty columns 80 rows 30

proc drain_until {seconds pattern} {
  set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" {
        puts stderr "unexpected project trust prompt"
        return 0
      }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

set expected {side-quests}
if {$mode eq "outside"} {
  set expected {Side Quests: tmux is required; extension is inactive\.}
}
if {![drain_until 8 $expected]} {
  puts stderr "Pi did not reach expected startup state: $expected"
  catch {send "\003\003"}
  catch {close}
  exit 1
}

send "\003\003"
expect eof
