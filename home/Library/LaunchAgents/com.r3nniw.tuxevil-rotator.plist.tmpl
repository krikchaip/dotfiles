<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.r3nniw.tuxevil-rotator</string>

    <key>ProgramArguments</key>
    <array>
      <string>{{ .chezmoi.homeDir }}/.local/bin/tuxevil-rotator-manager</string>
      <string>_run-sleepwatcher</string>
      <string>--verbose</string>

      <!-- system sleep → kill rotator -->
      <string>--sleep</string>
      <string>{{ .chezmoi.homeDir }}/.local/bin/tuxevil-rotator-manager _on-sleep</string>

      <!-- system wake → start rotator -->
      <string>--wakeup</string>
      <string>{{ .chezmoi.homeDir }}/.local/bin/tuxevil-rotator-manager _on-wake</string>

      <!-- display sleep → kill rotator -->
      <string>--displaysleep</string>
      <string>{{ .chezmoi.homeDir }}/.local/bin/tuxevil-rotator-manager _on-sleep</string>

      <!-- display wake → start rotator -->
      <string>--displaywakeup</string>
      <string>{{ .chezmoi.homeDir }}/.local/bin/tuxevil-rotator-manager _on-wake</string>

    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>{{ .chezmoi.homeDir }}/.local/share/mise/installs/node/latest/bin:{{ .chezmoi.homeDir }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/com.r3nniw.tuxevil-rotator.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.r3nniw.tuxevil-rotator.err.log</string>
  </dict>
</plist>
