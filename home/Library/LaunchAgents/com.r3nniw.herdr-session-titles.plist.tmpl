<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.r3nniw.herdr-session-titles</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/env</string>
      <string>mise</string>
      <string>exec</string>
      <string>--</string>
      <string>uv</string>
      <string>run</string>
      <string>--locked</string>
      <string>--script</string>
      <string>{{ .chezmoi.homeDir }}/.config/herdr/session-titles/claude_titles.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>{{ .chezmoi.homeDir }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/com.r3nniw.herdr-session-titles.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.r3nniw.herdr-session-titles.err.log</string>
  </dict>
</plist>
