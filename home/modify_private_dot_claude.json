{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $servers := dict
      "github" (dict
        "type" "http"
        "url" "https://api.githubcopilot.com/mcp"
        "headers" (dict "Authorization" "Bearer ${GITHUB_MCP_PAT}"))
      "obsidian" (dict
        "type" "stdio"
        "command" "bunx"
        "args" (list "--bun" "@mauricio.wolff/mcp-obsidian@latest" (joinPath .chezmoi.homeDir "Desktop/zettelkasten")))
-}}
{{- /* Claude Code rewrites this file in its own key order. Keep it as is
       when mcpServers already matches, so chezmoi status stays clean. */ -}}
{{- if eq (get $config "mcpServers" | toJson) (toJson $servers) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   $config | setValueAtPath "mcpServers" $servers | toPrettyJson -}}
{{- end -}}
