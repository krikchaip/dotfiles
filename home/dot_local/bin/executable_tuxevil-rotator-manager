#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/share/mise/installs/node/latest/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export TUXEVIL_ROTATOR_ADMIN_TOKEN="local"
export TUXEVIL_ROTATOR_BIND_HOST="127.0.0.1"

LABEL="com.r3nniw.tuxevil-rotator"

PLIST_PATH="$HOME/Library/LaunchAgents/${LABEL}.plist"
SERVICE_TARGET="gui/$(id -u)/${LABEL}"
OUT_LOG="/tmp/${LABEL}.out.log"
ERR_LOG="/tmp/${LABEL}.err.log"

SLEEPWATCHER_BIN="${SLEEPWATCHER_BIN:-/opt/homebrew/sbin/sleepwatcher}"
ROTATOR_BIN="${ROTATOR_BIN:-$(command -v tuxevil-rotator 2>/dev/null || true)}"
ROTATOR_PIDFILE="/tmp/${LABEL}.pid"
ROTATOR_LOG="/tmp/${LABEL}.rotator.log"

require_rotator_bin() {
  if [ -z "$ROTATOR_BIN" ]; then
    echo "Error: tuxevil-rotator is not installed or not on PATH." >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
tuxevil-rotator-manager - manage tuxevil-rotator LaunchAgent

Usage:
  tuxevil-rotator-manager                 Show this help
  tuxevil-rotator-manager -h|--help       Show this help
  tuxevil-rotator-manager start           Start/enable service
  tuxevil-rotator-manager kill            Stop/disable service
  tuxevil-rotator-manager restart         Restart service and flush logs
  tuxevil-rotator-manager logs [--err]    Follow stdout log (default) or stderr log
  tuxevil-rotator-manager status          Show service status
  tuxevil-rotator-manager login           Interactive login helper
EOF
}

log_event() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [tuxevil-rotator-manager] $*" >> "$OUT_LOG"
}

# ---------- Rotator process management (direct, not via launchd) ----------

rotator_pid() {
  if [ -f "$ROTATOR_PIDFILE" ]; then
    local pid
    pid=$(cat "$ROTATOR_PIDFILE")

    if kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi

    rm -f "$ROTATOR_PIDFILE"
  fi

  return 1
}

ROTATOR_STATE_CHANGED=""

rotator_start() {
  ROTATOR_STATE_CHANGED=""
  require_rotator_bin

  if pid=$(rotator_pid); then
    log_event "Rotator already running (pid $pid)"
    return 0
  fi

  nohup "$ROTATOR_BIN" start >> "$ROTATOR_LOG" 2>&1 &

  local new_pid=$!

  echo "$new_pid" > "$ROTATOR_PIDFILE"
  log_event "Rotator started (pid $new_pid)"

  ROTATOR_STATE_CHANGED="1"
}

rotator_kill() {
  ROTATOR_STATE_CHANGED=""

  if pid=$(rotator_pid); then
    kill "$pid" 2>/dev/null || true

    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
      sleep 0.5
      i=$((i + 1))
    done

    kill -9 "$pid" 2>/dev/null || true
    rm -f "$ROTATOR_PIDFILE"
    log_event "Rotator killed (pid $pid)"

    ROTATOR_STATE_CHANGED="1"
  else
    log_event "Rotator not running, nothing to kill"
  fi
}

notify() {
  local msg="$1"
  osascript -e "display notification \"$msg\" with title \"Tuxevil Rotator Manager\"" 2>/dev/null || true
}

# ---------- sleepwatcher hooks (internal, called by launchd plist) ----------

run_sleepwatcher() {
  rotator_start
  exec "$SLEEPWATCHER_BIN" "$@"
}

on_sleep() {
  log_event "Event: sleep/display-sleep"
  rotator_kill

  # [ -n "$ROTATOR_STATE_CHANGED" ] && notify "System sleeping — Rotator process stopped."
}

on_wake() {
  log_event "Event: wake/display-wake"
  rotator_start

  # [ -n "$ROTATOR_STATE_CHANGED" ] && notify "Resuming — Rotator process started."
}

# ---------- public commands ----------

require_plist() {
  if [ ! -f "$PLIST_PATH" ]; then
    echo "Error: plist not found: $PLIST_PATH" >&2
    echo "Apply chezmoi first so LaunchAgent is installed." >&2
    exit 1
  fi
}

service_state() {
  launchctl print "$SERVICE_TARGET" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*state = / { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }'
}

start_service() {
  require_plist

  local state=""
  if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
    state="$(service_state || true)"
    if [ "$state" = "running" ]; then
      rotator_start
      echo "Already running: $SERVICE_TARGET"
      return 0
    fi
  fi

  # Re-enable first. If service was disabled (e.g. via `tuxevil-rotator-manager kill`),
  # bootstrap can fail with opaque I/O errors until re-enabled.
  launchctl enable "$SERVICE_TARGET" >/dev/null 2>&1 || true

  if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
    launchctl kickstart -k "$SERVICE_TARGET" >/dev/null 2>&1 || true
  else
    launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
    launchctl kickstart -k "$SERVICE_TARGET" >/dev/null 2>&1 || true
  fi

  # Also start rotator immediately since user is active
  rotator_start

  state="$(service_state || true)"
  if [ "$state" = "running" ]; then
    echo "Started: $SERVICE_TARGET"
  else
    echo "Starting: $SERVICE_TARGET"
  fi
}

kill_service() {
  rotator_kill

  launchctl disable "$SERVICE_TARGET" >/dev/null 2>&1 || true
  launchctl bootout "gui/$(id -u)" "$PLIST_PATH" >/dev/null 2>&1 || true

  echo "Stopped/disabled: $SERVICE_TARGET"
}

restart_service() {
  kill_service
  rm -f "$OUT_LOG" "$ERR_LOG" "$ROTATOR_LOG"
  start_service

  echo "Logs flushed: $OUT_LOG, $ERR_LOG"
}

logs_service() {
  local file="$OUT_LOG"
  if [ "${1:-}" = "--err" ]; then
    file="$ERR_LOG"
  elif [ -n "${1:-}" ]; then
    echo "Unknown logs option: $1" >&2
    usage
    exit 1
  fi

  echo "Following: $file"
  tail -n 200 -F "$file"
}

status_service() {
  echo "Label:        $LABEL"
  echo "Plist:        $PLIST_PATH"
  echo "Stdout log:   $OUT_LOG"
  echo "Stderr log:   $ERR_LOG"
  echo "Rotator log:  $ROTATOR_LOG"

  if [ -f "$PLIST_PATH" ]; then
    echo "Plist exists: yes"
  else
    echo "Plist exists: no"
  fi

  echo
  echo "=== Sleepwatcher (launchd) ==="
  if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
    launchctl print "$SERVICE_TARGET" | grep -E "^\t(state =|pid =|last exit code =|path =|program =|disabled =)" || true
  else
    echo "Service not currently loaded in launchd."
    if launchctl print-disabled "gui/$(id -u)" 2>/dev/null | grep -q "\"$LABEL\" => true"; then
      echo "Disabled: true"
    fi
  fi

  echo
  echo "=== Rotator Process ==="
  if pid=$(rotator_pid); then
    echo "Running (pid $pid)"
  else
    echo "Not running"
  fi
}

login_service() {
  require_rotator_bin

  local accounts_file="$HOME/.tuxevil-rotator/accounts.json"
  local port=51200
  if [ -f "$accounts_file" ]; then
    port=$(jq -r '.proxyPort // 51200' "$accounts_file")
  fi


  while true; do
    local api_json
    api_json=$(curl -s --max-time 2 \
      -H "X-Rotator-Admin-Token: $TUXEVIL_ROTATOR_ADMIN_TOKEN" \
      "http://localhost:${port}/api/status" || true)

    echo ""
    echo "=== Logged In Accounts ==="
    if [ -n "$api_json" ] && echo "$api_json" | jq -e '.accounts' >/dev/null 2>&1; then
      echo "$api_json" | jq -r '.accounts[] | " - \(.email) [\(.status | ascii_upcase)] (label: \(.label // "none"))"'
    elif [ -f "$accounts_file" ]; then
      jq -r '.accounts[] | " - \(.email) [OFFLINE] (label: \(.label // "none"))"' "$accounts_file"
    else
      echo "No accounts logged in."
    fi
    echo "=========================="
    echo ""
    echo "1) Login/Add Google account"
    echo "2) Exit"
    echo ""
    read -p "Choose option: " choice

    if [ "$choice" = "1" ]; then
      local initial_count=0
      if [ -f "$accounts_file" ]; then
        initial_count=$(jq '.accounts | length' "$accounts_file")
      fi
      local added_any=0

      while true; do
        echo ""
        echo "Starting rotator login helper..."

        ROTATOR_LOGIN_LOG_FILE="/tmp/tuxevil-rotator-login-run.log"
        rm -f "$ROTATOR_LOGIN_LOG_FILE"
        touch "$ROTATOR_LOGIN_LOG_FILE"

        # Background monitor
        (
          while [ -f "$ROTATOR_LOGIN_LOG_FILE" ]; do
            if [ -s "$ROTATOR_LOGIN_LOG_FILE" ]; then
              local url
              url=$(grep -o -E 'https://accounts\.google\.com\S+' "$ROTATOR_LOGIN_LOG_FILE" | head -n 1)
              if [ -n "$url" ]; then
                open "$url"
                break
              fi
            fi
            sleep 0.5
          done
        ) &
        ROTATOR_LOGIN_MONITOR_PID=$!

        cleanup_login() {
          rm -f "${ROTATOR_LOGIN_LOG_FILE:-}"
          if [ -n "${ROTATOR_LOGIN_MONITOR_PID:-}" ]; then
            kill "$ROTATOR_LOGIN_MONITOR_PID" 2>/dev/null || true
          fi
        }
        trap cleanup_login EXIT INT TERM

        # Run the command with stdin/stdout connected
        "$ROTATOR_BIN" login 2>&1 | tee "$ROTATOR_LOGIN_LOG_FILE"

        trap - EXIT INT TERM
        cleanup_login
        wait "${ROTATOR_LOGIN_MONITOR_PID:-}" 2>/dev/null || true

        local current_count=0
        if [ -f "$accounts_file" ]; then
          current_count=$(jq '.accounts | length' "$accounts_file")
        fi

        if [ "$current_count" -gt "$initial_count" ]; then
          echo ""
          echo "Account added successfully."
          added_any=1
          initial_count=$current_count
        else
          echo ""
          echo "Login finished."
        fi

        read -p "Do you want to log in to another account? (y/N): " cont
        if [[ ! "$cont" =~ ^[yY]$ ]]; then
          break
        fi
      done

      if [ "$added_any" -eq 1 ]; then
        echo ""
        echo "New account(s) detected."
        read -p "Restart background service to apply changes? (Y/n): " restart
        if [[ ! "$restart" =~ ^[nN]$ ]]; then
          echo "Restarting service..."
          restart_service
        fi
      fi

    elif [ "$choice" = "2" ] || [ -z "$choice" ]; then
      break
    else
      echo "Invalid choice."
    fi
  done
}

main() {
  case "${1:-}" in
    ""|-h|--help)
      usage
      ;;
    start)
      start_service
      ;;
    kill)
      kill_service
      ;;
    restart)
      restart_service
      ;;
    logs)
      logs_service "${2:-}"
      ;;
    status)
      status_service
      ;;
    login)
      login_service
      ;;

    # Internal hooks called by launchd/sleepwatcher
    _run-sleepwatcher)
      shift
      run_sleepwatcher "$@"
      ;;
    _on-sleep) on_sleep ;;
    _on-wake)  on_wake  ;;

    *)
      echo "Unknown command: $1" >&2
      echo >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
