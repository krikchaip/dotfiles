#!/usr/bin/env bash

# lazygit-recent - persistent recent repository manager for lazygit

set -euo pipefail

DATA_DIR="${HOME}/.local/share/lazygit-recent"
REPO_FILE="${DATA_DIR}/repos.json"
STATE_FILE="${HOME}/Library/Application Support/lazygit/state.yml"

mkdir -p "$DATA_DIR"

if [[ ! -f "$REPO_FILE" ]]; then
    echo '[]' > "$REPO_FILE"
fi

is_git_repo() {
    local path="$1"
    [[ -d "$path" ]] && git -C "$path" rev-parse --git-dir > /dev/null 2>&1
}

abs_path_of() {
    (
        cd "$1"
        pwd -P
    )
}

show_help() {
    cat <<'EOF'
Usage: lazygit-recent [OPTIONS] [PATH...]

Persistent recent repository manager for lazygit.
Stores an infinite recent repo list in:
~/.local/share/lazygit-recent/repos.json

Options:
  -h, --help          Show this help message and exit
      --add [PATH]    Add git repository(s) to recent list.
                      Defaults to $PWD if no path is given.
      --delete PATH   Remove repository(s) from recent list.
      --migrate       Import LazyGit recentrepos into custom store.
      --picker        Always start in FZF picker loop.

No arguments:
  If inside a workspace repo: open the workspace picker, then loop back on quit.
                        A workspace repo has nested repos within
                        $LAZYGIT_RECENT_DEPTH levels (default 4).
  If inside a git repo: open plain lazygit in current repo.
                        Ctrl+R uses LazyGit builtin recent picker.
  Otherwise:            open FZF picker, then loop back on quit.

Workspace picker:
  Lists the workspace repo, its nested repos, and every worktree of them,
  also worktrees outside the workspace. Changed or unpushed ones come first.

FZF Keybindings:
  Enter               Open selected repo in lazygit
  Ctrl-X              Delete selected repo from recent list (recent picker only)
  Esc / Ctrl-C        Exit picker
EOF
}

cmd_list() {
    jq -r '.[]' "$REPO_FILE"
}

cmd_add() {
    local paths=("$@")

    if [[ ${#paths[@]} -eq 0 ]]; then
        paths=("$PWD")
    fi

    for path in "${paths[@]}"; do
        if [[ ! -d "$path" ]]; then
            echo "Error: $path does not exist" >&2
            continue
        fi

        if ! is_git_repo "$path"; then
            echo "Error: $path is not a git repository" >&2
            continue
        fi

        local abs_path
        abs_path=$(abs_path_of "$path")

        jq --arg path "$abs_path" '([$path] + .) | reduce .[] as $repo ([]; if index($repo) then . else . + [$repo] end)' "$REPO_FILE" > "${REPO_FILE}.tmp"
        mv "${REPO_FILE}.tmp" "$REPO_FILE"
        echo "Added $abs_path to lazygit recent repos"
    done
}

cmd_delete() {
    local path
    local target

    for path in "$@"; do
        if [[ -d "$path" ]]; then
            target=$(abs_path_of "$path")
        else
            target="$path"
        fi

        jq --arg path "$target" 'del(.[] | select(. == $path))' "$REPO_FILE" > "${REPO_FILE}.tmp"
        mv "${REPO_FILE}.tmp" "$REPO_FILE"
    done
}

prune_invalid_repos() {
    jq -r '.[]' "$REPO_FILE" | while IFS= read -r repo; do
        if is_git_repo "$repo"; then
            abs_path_of "$repo"
        fi
    done | jq -R . | jq -s 'reduce .[] as $repo ([]; if index($repo) then . else . + [$repo] end)' > "${REPO_FILE}.tmp"

    mv "${REPO_FILE}.tmp" "$REPO_FILE"
}

sync_custom_to_lazygit() {
    mkdir -p "$(dirname "$STATE_FILE")"

    if [[ ! -f "$STATE_FILE" ]]; then
        printf '{}\n' > "$STATE_FILE"
    fi

    local repos_json
    repos_json=$(jq -c . "$REPO_FILE")

    REPOS_JSON="$repos_json" yq -i '.recentrepos = (strenv(REPOS_JSON) | from_json)' "$STATE_FILE"
}

sync_lazygit_to_custom() {
    local top_repo
    top_repo=$(yq -r '.recentrepos[0] // empty' "$STATE_FILE" 2>/dev/null || true)

    if [[ -n "$top_repo" ]] && is_git_repo "$top_repo"; then
        local abs_path
        abs_path=$(abs_path_of "$top_repo")
        jq --arg path "$abs_path" '([$path] + .) | reduce .[] as $repo ([]; if index($repo) then . else . + [$repo] end)' "$REPO_FILE" > "${REPO_FILE}.tmp"
        mv "${REPO_FILE}.tmp" "$REPO_FILE"
    fi
}

cmd_migrate() {
    local recent_json='[]'
    local recent_repos

    recent_repos=$(yq -r '.recentrepos[]?' "$STATE_FILE" 2>/dev/null | while IFS= read -r repo; do
        if [[ -n "$repo" ]] && is_git_repo "$repo"; then
            abs_path_of "$repo"
        fi
    done || true)

    if [[ -n "$recent_repos" ]]; then
        recent_json=$(printf '%s\n' "$recent_repos" | jq -R . | jq -s 'reduce .[] as $repo ([]; if index($repo) then . else . + [$repo] end)')
    fi

    jq --argjson recent "$recent_json" '($recent + .) | reduce .[] as $repo ([]; if index($repo) then . else . + [$repo] end)' "$REPO_FILE" > "${REPO_FILE}.tmp"
    mv "${REPO_FILE}.tmp" "$REPO_FILE"

    sync_custom_to_lazygit

    local count
    count=$(cmd_list | wc -l | tr -d ' ')
    echo "Migrated $count repos from lazygit state."
}

next_repo_after_delete() {
    local deleted="$1"
    local repos=()

    mapfile -t repos < <(cmd_list)

    for i in "${!repos[@]}"; do
        if [[ "${repos[i]}" != "$deleted" ]]; then
            continue
        fi

        if (( i + 1 < ${#repos[@]} )); then
            printf '%s\n' "${repos[i + 1]}"
            return 0
        fi

        if (( i > 0 )); then
            printf '%s\n' "${repos[i - 1]}"
            return 0
        fi

        return 1
    done

    return 1
}

preferred_repo_after_return() {
    jq -r '.[1] // .[0] // empty' "$REPO_FILE"
}

parse_fzf_result() {
    FZF_KEY=""
    FZF_SELECTION=""

    local result="$1"
    local lines=()

    mapfile -t lines <<< "$result"

    if [[ ${#lines[@]} -eq 2 ]]; then
        FZF_KEY="${lines[0]}"
        FZF_SELECTION="${lines[1]}"
        return
    fi

    FZF_SELECTION="${lines[0]:-}"
}

run_fzf() {
    local preferred_selection="${1:-}"

    prune_invalid_repos

    local repos
    repos=$(cmd_list)

    if [[ -z "$repos" ]]; then
        echo "No recent repositories found." >&2
        return 1
    fi

    local pos=0
    if [[ -n "$preferred_selection" ]]; then
        pos=$(printf '%s\n' "$repos" | grep -n -F -x "$preferred_selection" | head -1 | cut -d: -f1 || echo "0")
    fi

    local fzf_opts=(
        --layout=reverse
        --expect=ctrl-x
        --bind='ctrl-n:down'
        --bind='ctrl-p:up'
        --border=rounded
        --border-label=" Lazygit Recent Repos "
        --info=inline-right
        --prompt="❯ "
        --pointer="▶"
        --header=$'Keybindings: enter=open, ctrl-x=delete\n\nPath'
    )

    if [[ "$pos" -gt 0 ]]; then
        fzf_opts+=(--bind="load:pos($pos)")
    fi

    printf '%s\n' "$repos" | env TERM=xterm-256color fzf "${fzf_opts[@]}"
}

run_lazygit() {
    local repo="$1"
    sync_custom_to_lazygit
    lazygit -p "$repo"
    sync_lazygit_to_custom
    sync_custom_to_lazygit
}

run_picker_loop() {
    local preferred_selection=""

    while true; do
        local result
        result=$(run_fzf "$preferred_selection") || break

        parse_fzf_result "$result"

        if [[ -z "$FZF_SELECTION" ]]; then
            break
        fi

        if [[ "$FZF_KEY" == "ctrl-x" ]]; then
            preferred_selection=$(next_repo_after_delete "$FZF_SELECTION" || true)
            cmd_delete "$FZF_SELECTION"
            sync_custom_to_lazygit
            continue
        fi

        cmd_add "$FZF_SELECTION" > /dev/null
        run_lazygit "$FZF_SELECTION"
        preferred_selection=$(preferred_repo_after_return)
    done
}

run_git_repo() {
    local current_repo
    current_repo=$(abs_path_of "$PWD")

    cmd_add "$current_repo" > /dev/null
    run_lazygit "$current_repo"
}

WORKSPACE_DEPTH="${LAZYGIT_RECENT_DEPTH:-4}"

# Nested repo, worktree, and submodule folders under root (one absolute path per line)
find_nested_repos() {
    local root="$1"

    command -v fd > /dev/null 2>&1 || return 0

    fd --hidden --no-ignore --no-require-git --prune --max-depth "$WORKSPACE_DEPTH" \
        --exclude node_modules '^\.git$' "$root" 2> /dev/null |
        sed -E 's|/\.git/?$||' |
        grep -v -x -F "$root" || true
}

# Linked worktree folders recorded in a .git directory (file reads, no git process)
worktrees_of_git_dir() {
    local git_dir="$1"
    local gitdir_file worktree

    for gitdir_file in "$git_dir"/worktrees/*/gitdir; do
        [[ -f "$gitdir_file" ]] || continue
        read -r worktree < "$gitdir_file"
        printf '%s\n' "${worktree%/.git}"
    done
}

# Every checkout of root and its nested repos, including linked worktrees outside root
workspace_paths() {
    local root="$1"

    { printf '%s\n' "$root"; find_nested_repos "$root"; } | while IFS= read -r repo; do
        printf '%s\n' "$repo"
        if [[ -d "$repo/.git" ]]; then
            worktrees_of_git_dir "$repo/.git"
        elif [[ -f "$repo/.git" ]]; then
            # A linked worktree: its main repo and sibling worktrees
            local link main_git_dir
            read -r link < "$repo/.git"
            link="${link#gitdir: }"
            if [[ "$link" == /*/worktrees/* ]]; then
                main_git_dir="${link%/worktrees/*}"
                printf '%s\n' "${main_git_dir%/.git}"
                worktrees_of_git_dir "$main_git_dir"
            fi
        fi
    done | awk '!seen[$0]++' | while IFS= read -r path; do
        if [[ -d "$path" ]]; then
            printf '%s\n' "$path"
        fi
    done
}

# One tab-separated line: path, sort key, label, state, branch, kind
workspace_entry() {
    local root="$1"
    local path="$2"

    # Two git processes per entry: rev-parse for the kind, status for branch, changes, and ahead
    local dirs git_dir="" common_dir="" superproject=""
    dirs=$(git -C "$path" rev-parse --path-format=absolute --absolute-git-dir --git-common-dir --show-superproject-working-tree 2> /dev/null) || return 0
    { read -r git_dir; read -r common_dir; read -r superproject; } <<< "$dirs" || true

    local status_out
    status_out=$(git --no-optional-locks -C "$path" status --porcelain=v2 --branch 2> /dev/null) || return 0

    local label
    if [[ "$path" == "$root" ]]; then
        label="(root)"
    elif [[ "$path" == "$root"/* ]]; then
        label="${path#"$root"/}"
    elif [[ "$path" == "$HOME"/* ]]; then
        label="~${path#"$HOME"}"
    else
        label="$path"
    fi

    local kind main_dir
    if [[ -n "$superproject" ]]; then
        kind="submodule"
    elif [[ "$git_dir" != "$common_dir" ]]; then
        main_dir="${common_dir%/.git}"
        kind="worktree of ${main_dir##*/}"
    else
        kind="repo"
    fi

    local branch="" ahead="" changed=0 line
    while IFS= read -r line; do
        case "$line" in
            "# branch.head "*) branch="${line#"# branch.head "}" ;;
            "# branch.ab +"*) ahead="${line#"# branch.ab +"}"; ahead="${ahead%% *}" ;;
            "#"*) ;;
            ?*) changed=$((changed + 1)) ;;
        esac
    done <<< "$status_out"
    [[ "$branch" == "(detached)" ]] && branch=""

    # No upstream: count commits that are on no remote branch
    if [[ -z "$ahead" ]]; then
        ahead=$(git -C "$path" rev-list --count HEAD --not --remotes 2> /dev/null || echo 0)
    fi

    # Sort key: 0 = changed or unpushed, 1 = clean root, 2 = other clean entries
    local state="" key=2
    [[ "$path" == "$root" ]] && key=1
    if [[ "$changed" -gt 0 ]]; then
        state="${changed} changed"
        key=0
    fi
    if [[ "$ahead" -gt 0 ]]; then
        state="${state:+$state }↑${ahead}"
        key=0
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "$key" "$label" "${state:-clean}" "${branch:-detached}" "$kind"
}

# Picker lines: absolute path, a tab, then aligned columns
workspace_lines() {
    local root="$1"
    local tmp_dir
    tmp_dir=$(mktemp -d)

    local i=0
    while IFS= read -r path; do
        workspace_entry "$root" "$path" > "${tmp_dir}/${i}" &
        i=$((i + 1))
    done < <(workspace_paths "$root")
    wait

    cat "$tmp_dir"/* 2> /dev/null |
        LC_ALL=C sort -t $'\t' -k2,2 -k3,3 |
        awk -F '\t' '
            # Display width: "↑" is one column but several bytes, so count it as one character
            function width(s) { gsub(/↑/, "^", s); return length(s) }
            function pad(s, w,    n) { n = w - width(s); while (n-- > 0) s = s " "; return s }
            BEGIN { wl = width("Path"); ws = width("Status"); wb = width("Branch") }
            {
                path[NR] = $1; label[NR] = $3; state[NR] = $4; branch[NR] = $5; kind[NR] = $6
                if (width($3) > wl) wl = width($3)
                if (width($4) > ws) ws = width($4)
                if (width($5) > wb) wb = width($5)
            }
            END {
                printf "\t%s  %s  %s  %s\n", pad("Path", wl), pad("Status", ws), pad("Branch", wb), "Kind"
                for (i = 1; i <= NR; i++) {
                    printf "%s\t%s  %s  %s  %s\n", path[i], pad(label[i], wl), pad(state[i], ws), pad(branch[i], wb), kind[i]
                }
            }' || true

    rm -rf "$tmp_dir"
}

run_workspace_loop() {
    local root="$1"
    local last_selection=""

    while true; do
        # The first line is the column header, aligned with the entries
        local lines header
        lines=$(workspace_lines "$root")
        header="${lines%%$'\n'*}"
        header="${header#*$'\t'}"
        lines="${lines#*$'\n'}"

        local pos=0
        if [[ -n "$last_selection" ]]; then
            pos=$(printf '%s\n' "$lines" | awk -F '\t' -v p="$last_selection" '$1 == p { print NR; exit }')
        fi

        local fzf_opts=(
            --layout=reverse
            --delimiter=$'\t'
            --with-nth=2
            --bind='ctrl-n:down'
            --bind='ctrl-p:up'
            --border=rounded
            --border-label=" Workspace: $(basename "$root") "
            --info=inline-right
            --prompt="❯ "
            --pointer="▶"
            --header=$'Keybindings: enter=open\n\n'"$header"
        )

        if [[ "${pos:-0}" -gt 0 ]]; then
            fzf_opts+=(--bind="load:pos($pos)")
        fi

        local result
        result=$(printf '%s\n' "$lines" | env TERM=xterm-256color fzf "${fzf_opts[@]}") || break

        local selection="${result%%$'\t'*}"
        if [[ -z "$selection" ]]; then
            break
        fi

        cmd_add "$selection" > /dev/null
        run_lazygit "$selection"
        last_selection="$selection"
    done
}

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    --add)
        shift
        cmd_add "$@"
        sync_custom_to_lazygit
        ;;
    --delete)
        shift
        cmd_delete "$@"
        sync_custom_to_lazygit
        ;;
    --migrate)
        cmd_migrate
        sync_custom_to_lazygit
        ;;
    --picker)
        run_picker_loop
        ;;
    "")
        if git rev-parse --git-dir > /dev/null 2>&1; then
            workspace_root=$(git rev-parse --show-toplevel 2> /dev/null || true)
            if [[ -n "$workspace_root" && -n "$(find_nested_repos "$workspace_root")" ]]; then
                run_workspace_loop "$workspace_root"
            else
                run_git_repo
            fi
        else
            run_picker_loop
        fi
        ;;
    *)
        cmd_add "$@"
        sync_custom_to_lazygit
        ;;
esac
